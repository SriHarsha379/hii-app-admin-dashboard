# Hii App Environment Variables

# Server
PORT=3000
NODE_ENV=development

# MongoDB Atlas (shared with Flutter app)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.auiuvqn.mongodb.net/nightlifeDB?retryWrites=true&w=majority

# Auth
JWT_SECRET=your_super_secret_jwt_key
ADMIN_PASSWORD_HASH_ROUNDS=10

# Gemini API (Pre-configured in environment)
GEMINI_API_KEY=
